{
  "name": "faceshape-react",
  "version": "0.1.0",
  "description": "Composable animated SVG characters for React",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json && tsc -p tsconfig.tests.json",
    "test": "npm run build && node tests/build-helpers.mjs && node --test tests/*.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "demo:build": "vite build",
    "prepack": "npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:visual:update": "npm run build && node tests/build-helpers.mjs && UPDATE_VISUALS=1 node --test tests/visual.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "keywords": [
    "react",
    "svg",
    "avatar",
    "animation",
    "character"
  ],
  "license": "UNLICENSED"
}
